// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BUYER
  SELLER
}

enum NotificationCategory {
  MESSAGES
  LISTINGS
  ENGAGEMENT
  SAVED_SEARCHES
  SYSTEM
  SECURITY
}

enum NotificationType {
  MESSAGE_RECEIVED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_EXPIRING
  LISTING_EXPIRED
  LISTING_FAVORITED_AGGREGATE
  REVIEW_RECEIVED
  SAVED_SEARCH_MATCHES
  SYSTEM_ANNOUNCEMENT
  SECURITY_ALERT
}

enum NotificationOutboxState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD
}

enum NotificationBroadcastStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationBroadcastAudience {
  ALL
  ROLES
  USERS
}

model User {
  id              String   @id
  firebaseUid     String   @unique
  email           String
  name            String
  avatarUrl       String?
  bio             String?
  phone           String?
  role            Role     @default(BUYER)
  accountStatus   String
  isEmailVerified Boolean
  isPhoneVerified Boolean   @default(false)
  isIdVerified    Boolean   @default(false)
  avgRating       Float     @default(0)
  totalReviews    Int       @default(0)
  totalListings   Int       @default(0)
  totalSold       Int       @default(0)
  lastLoginAt     DateTime?
  createdAt       DateTime
  updatedAt       DateTime

  listings        Listing[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  reviewsGiven    Review[]   @relation("ReviewerRelation")
  reviewsReceived Review[]   @relation("SellerRelation")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
}

model Notification {
  id             String               @id @default(cuid())
  userId         String
  type           NotificationType
  category       NotificationCategory
  title          String
  body           String
  actionUrl      String?
  entityType     String?
  entityId       String?
  metadata       Json                 @default("{}")
  dedupeKey      String?              @unique
  aggregationKey String?
  readAt         DateTime?
  deletedAt      DateTime?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)

  @@index([userId, deletedAt, createdAt])
  @@index([userId, readAt, deletedAt])
  @@index([aggregationKey, createdAt])
}

model NotificationPreference {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)

  @@unique([userId, category])
}

model NotificationOutbox {
  id            String                  @id @default(cuid())
  eventType     NotificationType
  aggregateType String
  aggregateId   String
  recipientId   String?
  payload       Json
  dedupeKey     String                  @unique
  state         NotificationOutboxState @default(PENDING)
  attempts      Int                     @default(0)
  availableAt   DateTime                @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([state, availableAt, createdAt])
}

model NotificationBroadcast {
  id             String                        @id @default(cuid())
  audience       NotificationBroadcastAudience
  audienceValue  Json
  title          String
  body           String
  actionUrl      String?
  status         NotificationBroadcastStatus   @default(PENDING)
  cursor         String?
  deliveredCount Int                           @default(0)
  createdBy      String
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@index([status, createdAt])
}

model Listing {
  id                    String    @id
  title                 String
  titleLower            String
  searchText            String    @default("")
  clientRequestId       String?
  description           String
  price                 Float
  currency              String
  priceType             String
  categoryId            String
  ownerId               String?
  ownerSnapshotName     String
  ownerSnapshotPhotoUrl String
  locationCountry       String
  locationCity          String
  locationArea          String
  status                String
  condition             String
  contactPreference     String
  viewsCount            Int
  favoritesCount        Int
  messagesCount         Int
  isFeatured            Boolean
  isApproved            Boolean
  publishedAt           DateTime?
  soldAt                DateTime?
  archivedAt            DateTime?
  expiresAt             DateTime?
  createdAt             DateTime
  updatedAt             DateTime
  deletedAt             DateTime?

  owner         User?          @relation(fields: [ownerId], references: [firebaseUid], onDelete: SetNull)
  favorites     Favorite[]
  uploads       Upload[]
  listingImages ListingImage[]

  @@index([ownerId])
  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([locationCity])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([price])
  @@index([expiresAt])
  @@index([categoryId, status, createdAt])
  @@index([locationCity, status, createdAt])
  @@index([isFeatured, status, createdAt])
  @@unique([ownerId, clientRequestId], map: "listings_owner_client_request_unique")
}

model ListingModerationLog {
  id             String   @id
  listingId      String
  adminUserId    String
  action         String
  reason         String?
  previousStatus String?
  newStatus      String?
  createdAt      DateTime

  @@index([listingId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  url       String
  path      String
  isPrimary Boolean
  order     Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, order])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String?
  createdAt DateTime

  user    User     @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([userId, listingId], map: "favorites_user_listing_unique")
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  query     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Conversation {
  id                             String    @id
  listingId                      String
  listingSnapshotTitle           String
  listingSnapshotPrimaryImageURL String
  createdBy                      String
  lastMessageText                String
  lastMessageSenderId            String
  lastMessageAt                  DateTime?
  lastMessageType                String
  isActive                       Boolean
  createdAt                      DateTime
  updatedAt                      DateTime

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String
  fullName       String
  photoURL       String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id
  conversationId String
  senderId       String
  type           String
  text           String
  attachments    Json
  isRead         Boolean
  readAt         DateTime?
  createdAt      DateTime
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Category {
  id        String    @id
  nameAr    String
  nameEn    String
  slug      String    @unique
  isActive  Boolean
  sortOrder Int
  createdAt DateTime?
  updatedAt DateTime?
}

model City {
  id        String    @id
  nameAr    String
  nameEn    String
  slug      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime?
  updatedAt DateTime?

  @@index([isActive, sortOrder])
  @@index([slug])
}

model Upload {
  id        String   @id @default(cuid())
  url       String
  path      String
  listingId String?
  createdAt DateTime

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
}

model Report {
  id           String   @id
  targetType   String
  targetId     String
  reasonCode   String
  details      String
  reporterId   String
  status       String
  moderatorId  String?
  moderatorNote String?
  createdAt    DateTime
  updatedAt    DateTime

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

model AuditLog {
  id         String   @id
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json
  createdAt  DateTime

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model Review {
  id         String   @id
  sellerId   String
  reviewerId String
  listingId  String
  rating     Int
  comment    String
  createdAt  DateTime
  updatedAt  DateTime

  seller   User @relation("SellerRelation", fields: [sellerId], references: [firebaseUid], onDelete: Cascade)
  reviewer User @relation("ReviewerRelation", fields: [reviewerId], references: [firebaseUid], onDelete: Cascade)

  @@unique([reviewerId, listingId], map: "reviews_reviewer_listing_unique")
  @@index([sellerId, createdAt])
  @@index([listingId])
}

model EngagementEvent {
  id             String   @id
  eventType      String
  listingId      String?
  conversationId String?
  actorId        String?
  metadata       Json
  createdAt      DateTime

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([listingId, createdAt])
}
